{
	"name": "my-todo-app",
	"module": "index.ts",
	"type": "module",
	"devDependencies": {
		"@biomejs/biome": "2.3.14",
		"@types/bun": "latest"
	},
	"scripts": {
		"dev": "NODE_ENV=development  bun run --env-file=.env.development --watch index.ts",
		"local": "NODE_ENV=local bun run --env-file=.env.production.local --watch index.ts",
		"prod": "NODE_ENV=production bun run --env-file=.env.production  --watch index.ts",
		"start": "bun run --env-file=.env --watch index.ts"
	},
	"peerDependencies": {
		"typescript": "^5.0.0"
	},
	"dependencies": {
		"@neondatabase/serverless": "^1.0.2",
		"@types/cors": "^2.8.19",
		"@types/express": "^5.0.6",
		"@vercel/functions": "^3.4.3",
		"cors": "^2.8.5",
		"express": "^5.2.1",
		"mysql2": "^3.16.0",
		"pg": "^1.0.2"
	},
	"overrides": {
		"pg": "npm:@neondatabase/serverless@^1.0.0"
	}
}
